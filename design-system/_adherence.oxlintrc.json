{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "ui_kits/agent-dashboard/**",
              "ui_kits/marketing/**",
              "ui_kits/monster-survivor/**",
              "ui_kits/rainbow-rest-stop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:OpenDyslexic|OpenDyslexicMono|OpenDyslexicAlta|Archivo|Hanken Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: OpenDyslexic, OpenDyslexicMono, OpenDyslexicAlta, Archivo, Hanken Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadingModeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:compact|className|key|ref|className|style|children)$/]",
        "message": "<ReadingModeToggle> doesn't accept that prop. Declared props: compact, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
